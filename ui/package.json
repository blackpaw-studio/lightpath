{
  "name": "lightpath-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('node:fs').writeFileSync('dist/.gitkeep', '')\"",
